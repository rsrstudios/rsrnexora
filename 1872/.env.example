# ==========================================
# RSR Nexora V7 - Production Environment Configuration
# ==========================================
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# In Google AI Studio / Cloud Run, manage secrets securely via the Settings / Secrets menu.

# 1. AI Provider Credentials & 10-Slot Automatic Fallback System
# Server-side only: never exposed to browser client
GEMINI_API_KEY=

# API 01 — Primary Provider (Defaults to Gemini with GEMINI_API_KEY if not specified)
API_01_PROVIDER=gemini
API_01_BASE_URL=
API_01_MODEL=gemini-3.8-flash
API_01_KEY=

# API 02 — Backup Provider
API_02_PROVIDER=openai-compatible
API_02_BASE_URL=https://api.openai.com/v1
API_02_MODEL=gpt-4o-mini
API_02_KEY=

# API 03 — Backup Provider
API_03_PROVIDER=openai-compatible
API_03_BASE_URL=https://api.groq.com/openai/v1
API_03_MODEL=llama-3.3-70b-versatile
API_03_KEY=

# API 04 — Backup Provider
API_04_PROVIDER=openai-compatible
API_04_BASE_URL=https://api.mistral.ai/v1
API_04_MODEL=mistral-small-latest
API_04_KEY=

# API 05 — Backup Provider
API_05_PROVIDER=openai-compatible
API_05_BASE_URL=https://api.deepseek.com/v1
API_05_MODEL=deepseek-chat
API_05_KEY=

# API 06 — Backup Provider
API_06_PROVIDER=openai-compatible
API_06_BASE_URL=https://openrouter.ai/api/v1
API_06_MODEL=anthropic/claude-3.5-haiku
API_06_KEY=

# API 07 — Backup Provider
API_07_PROVIDER=openai-compatible
API_07_BASE_URL=https://api.together.xyz/v1
API_07_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
API_07_KEY=

# API 08 — Backup Provider
API_08_PROVIDER=openai-compatible
API_08_BASE_URL=https://api.perplexity.ai
API_08_MODEL=sonar
API_08_KEY=

# API 09 — Backup Provider
API_09_PROVIDER=openai-compatible
API_09_BASE_URL=
API_09_MODEL=
API_09_KEY=

# API 10 — Backup Provider
API_10_PROVIDER=openai-compatible
API_10_BASE_URL=
API_10_MODEL=
API_10_KEY=


# 2. Application & Deployment URLs
# Base URL where the app is served (injected by Cloud Run in production)
APP_URL=https://ais-dev-bxbidldjjxizzrvssulonf-867678484196.asia-southeast1.run.app

# 3. Environment & Logging
NODE_ENV=production
LOG_LEVEL=info

# 4. Session & Cryptography
# High-entropy secret for HMAC token signing and session verification
SESSION_SECRET=

# 5. CORS & Network Security
# Comma-separated list of allowed origins (e.g., https://example.com,https://app.example.com or * for dev)
ALLOWED_ORIGINS=*

# 6. Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000

# 7. Subscription & Payment System (INR Subscriptions)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# 8. Supabase Persistence Engine
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
